{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":automergePr"
  ],
  "schedule": ["before 1am on sunday"],
  "separateMajorMinor": false,
  "minimumReleaseAge": "10 days",
  "packageRules": [
    {
      "description": "Managed Python environments stay on the supported 3.14 series; review a minor upgrade explicitly.",
      "matchDepNames": [
        "python",
        "cpython"
      ],
      "allowedVersions": ">=3.14 <3.15"
    },
    {
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "container base images"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "cli tools"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies"
    },
    {
      "description": "Digest updates (action SHAs, the igou-devenv commit pin) carry no release timestamp, so the age gate would pend forever. Matches renovate-base.json.",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "description": "Update pinned versions in Ansible defaults",
      "customType": "regex",
      "managerFilePatterns": ["roles/**/*.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\w+:\\s+\"?(?<currentValue>[^\"\\n]+)\"?"
      ],
      "versioningTemplate": "semver"
    },
    {
      "description": "Update pinned pip package versions in Ansible defaults",
      "customType": "regex",
      "managerFilePatterns": ["roles/**/*.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+-\\s+\"\\S+=+(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "pep440"
    },
    {
      "description": "Advance the igou-devenv mise.toml/mise.lock source pin (the mise binary version follows it)",
      "customType": "regex",
      "managerFilePatterns": ["roles/packages/defaults/main.yml"],
      "matchStrings": [
        "packages_mise_source_ref:\\s+\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "igou-devenv",
      "packageNameTemplate": "https://github.com/igou-io/igou-devenv",
      "currentValueTemplate": "main"
    }
  ]
}
